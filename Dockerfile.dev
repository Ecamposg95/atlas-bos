# syntax=docker/dockerfile:1.6

FROM python:3.12-slim

# System libs required by psycopg2-binary (libpq) and xhtml2pdf/pillow/pycairo (cairo).
# Mirrors nixpacks.toml so Docker dev and Railway prod stay aligned.
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        pkg-config \
        libpq-dev \
        libcairo2-dev \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Python deps first — this layer caches when only app code changes.
COPY requirements.txt ./
RUN pip install --no-cache-dir --upgrade pip \
 && pip install --no-cache-dir -r requirements.txt

# Application source. .dockerignore keeps .env, venv, node_modules, .git out.
COPY . .

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
